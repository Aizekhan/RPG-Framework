# Installed by RPG Framework > Game Kit > Install AI Guidance (only when the project had no .gitattributes).
# Binary assets go to Git LFS (https://git-lfs.com): without it every saved model, texture and sound stays in the
# history forever and the repository grows by hundreds of megabytes. Install it once per machine: `git lfs install`.
# Files committed before this file existed stay in the history; `git lfs migrate import --everything --include=...`
# moves them, but it rewrites history (agree with everyone who has a copy first).
# Hosts limit LFS storage and bandwidth (check your plan); CI checks out LFS files on every run.

* text=auto

# Unity YAML is text
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.meta text

# 3D models
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.3ds filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text

