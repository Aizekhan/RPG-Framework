{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "tr -d '\\r' < \"$CLAUDE_PROJECT_DIR/.claude/hooks/framework-update-check.sh\" | bash",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-remote:*)",
      "Bash(unity test:*)",
      "Bash(unity recompile:*)"
    ]
  }
}
